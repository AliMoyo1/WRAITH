  - id: exploit_hydra
    label: "Hydra Brute Force"
    detection_domains: [exploitation]
    layers: [8]
    target_types: [ip, url, api]
    gated: true
    tools: [hydra]
  - id: exploit_ad
    label: "AD Exploitation"
    detection_domains: [ad_exploitation]
    layers: [8]
    target_types: [ip, domain]
    gated: true
    tools: [bloodhound, impacket]
  - id: exploit_burp
    label: "Burp Suite Automation"
    detection_domains: [exploitation]
    layers: [8]
    target_types: [url, api]
    gated: true
    tools: [burpsuite]
  - id: exploit_generic
    label: "Generic Exploit Chain"
    detection_domains: [exploitation]
    layers: [8]
    target_types: [ip, url, api]
    gated: true

  - id: post_exploit_privesc
    label: "Privilege Escalation"
    detection_domains: [privilege_escalation]
    layers: [9]
    target_types: [ip]
    gated: true
  - id: post_exploit_lateral
    label: "Lateral Movement"
    detection_domains: [lateral_movement]
    layers: [9]
    target_types: [ip, domain]
    gated: true
  - id: post_exploit_credential
    label: "Credential Access"
    detection_domains: [credential_access]
    layers: [9]
    target_types: [ip, domain]
    gated: true
  - id: post_exploit_exfiltration
    label: "Data Exfiltration"
    detection_domains: [exfiltration]
    layers: [9]
    target_types: [ip, domain]
    gated: true

  # Layers 10-12: Post-Engagement (no offensive capabilities here)
  # Layer 10: Evidence & Reporting — handled by the core WRAITH report engine
  # Layer 11: Remediation Validation — no redteam capability
  # Layer 12: Program Governance — no redteam capability

# Tool definitions (for --dry-run install checks)
tools:
  nmap:
    description: "Network discovery and security scanning"
    install_check: "nmap --version"
    commands: {quick: "nmap -sV -sC -T4 {target} -oA {output}/nmap_quick", full: "nmap -sV -sC -p- {target} -oA {output}/nmap_full"}
  sqlmap:
    description: "Automatic SQL injection and database takeover"
    install_check: "sqlmap --version"
    commands: {standard: "sqlmap -u {target} --batch --dbs --stop=5", crawl: "sqlmap -u {target} --batch --crawl=3"}
  masscan:
    description: "High-speed port scanner"
    install_check: "masscan --version"
    commands: {quick: "masscan {target} --ports=1-65535 --rate=1000"}
  hydra:
    description: "Network login cracker"
    install_check: "hydra -h"
    commands: {ssh: "hydra -l root -P /usr/share/wordlists/rockyou.txt ssh://{target}"}
  metasploit:
    description: "Metasploit Framework"
    install_check: "msfconsole --version"
    commands: {console: "msfconsole -q -x 'search {target}'"}
  burpsuite:
    description: "Burp Suite Professional / Community"
    install_check: "java -jar burpsuite.jar --version 2>/dev/null || echo 'burpsuite'"
  bloodhound:
    description: "Active Directory path discovery"
    install_check: "bloodhound-python --version 2>/dev/null || bloodhound --version 2>/dev/null || echo 'bloodhound'"
  impacket:
    description: "Impacket suite for AD protocols"
    install_check: "impacket-smbclient -h 2>/dev/null || impacket-getTGT -h 2>/dev/null || echo 'impacket'"
  shodan:
    description: "Shodan search engine"
    install_check: "shodan --version 2>/dev/null || echo 'shodan'"
  whois:
    description: "WHOIS lookup"
    install_check: "whois --version 2>/dev/null || echo 'whois'"
  dig:
    description: "DNS lookup utility"
    install_check: "dig -v 2>/dev/null || echo 'dig'"

# Target-type defaults (auto-selected capabilities per target type)
target_type_defaults:
  url:
    auto_capabilities: [recon_passive, recon_active, web_sqli, web_xss, web_csrf, web_ssrf, web_path_traversal, web_file_upload, web_rce, web_info_disclosure, web_wordpress, api_idor, api_auth, api_jwt, api_graphql, api_fuzzing, agentic_prompt_injection, agentic_tool_misuse, agentic_excessive_agency]
  api:
    auto_capabilities: [recon_passive, recon_active, api_idor, api_auth, api_jwt, api_graphql, api_fuzzing, web_sqli, web_ssrf, web_path_traversal, agentic_prompt_injection, agentic_tool_misuse, agentic_excessive_agency]
  ip:
    auto_capabilities: [recon_passive, recon_active, network_scan, network_smtp, network_ssh, network_ad_enum, post_exploit_privesc, post_exploit_lateral, post_exploit_credential]
  cidr:
    auto_capabilities: [recon_passive, recon_active, network_scan, network_smtp, network_ssh, network_ad_enum, cloud_iam, cloud_gcp, post_exploit_privesc, post_exploit_lateral, post_exploit_credential]
  domain:
    auto_capabilities: [recon_passive, recon_active, web_sqli, web_xss, web_csrf, web_ssrf, web_path_traversal, web_info_disclosure, web_wordpress, network_ad_enum]
  repo_path:
    auto_capabilities: [sast_secrets, sast_deserialization, sast_supply_chain, sast_code_review, agentic_prompt_injection, agentic_tool_misuse, agentic_excessive_agency]