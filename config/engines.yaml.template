# WRAITH Engine Configuration
# Copy this template to engines.yaml and edit paths for your machine.

engines:
  skillspector:
    path: ./repos/SkillSpector
    type: python
    venv: .venvs/skillspector
    isolation: venv
    license: Apache-2.0

  strix:
    path: ./repos/strix
    type: python
    venv: .venvs/strix
    isolation: venv
    license: Apache-2.0

  cubesandbox:
    path: ./repos/CubeSandbox
    type: rust
    isolation: binary
    license: Apache-2.0

  ponytail:
    path: ./repos/ponytail
    type: node
    isolation: npx
    license: MIT

  metasploit:
    path: ""  # System install, not bundled
    type: system
    command: msfconsole
    license: BSD

  sqlmap:
    path: ""  # System install, not bundled
    type: system
    command: sqlmap
    license: GPLv2

  burp:
    path: ""  # Commercial, user-installed only
    type: system
    command: burpsuite
    license: Commercial

# Orchestrator settings
orchestrator:
  max_parallel: 3
  kill_switch_timeout: 5
  human_gate_required: false  # Set true before Layer 8-9 work